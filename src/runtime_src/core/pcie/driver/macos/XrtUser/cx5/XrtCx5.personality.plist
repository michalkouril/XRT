<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The ConnectX-5 personality, merged into Info.plist's IOKitPersonalities ONLY by
     a build.sh run with XRT_MACOS_CX5=1. It is a separate file, and not part of the
     default Info.plist, because matching here DISPLACES Apple's own
     com.apple.DriverKit-AppleEthernetMLX5 on every Mellanox Ethernet function.

     IOPCIMatch is the exact Innova-2 ConnectX-5 id (0x1017 device, 0x15b3 vendor) and
     nothing wider: AppleEthernetMLX5 matches 0x15b3 generically by class, so a wide
     match here would claim unrelated Mellanox hardware too. IOProbeScore outranks
     Apple's driver, which is the whole point and also the whole risk - see the warning
     printed by build.sh. -->
<plist version="1.0">
<dict>
  <key>XrtCx5</key>
  <dict>
    <key>CFBundleIdentifier</key><string>org.xrtmac.XrtUser</string>
    <key>CFBundleIdentifierKernel</key><string>com.apple.kpi.iokit</string>
    <key>IOClass</key><string>IOUserService</string>
    <key>IOProviderClass</key><string>IOPCIDevice</string>
    <key>IOUserClass</key><string>XrtCx5</string>
    <key>IOUserServerName</key><string>org.xrtmac.XrtUser</string>
    <key>IOPCITunnelCompatible</key><true/>
    <key>IOPCIMatch</key><string>0x101715b3</string>
    <key>IOProbeScore</key><integer>100000</integer>
    <key>UserClientProperties</key>
    <dict>
      <key>IOClass</key><string>IOUserUserClient</string>
      <key>IOUserClass</key><string>XrtCx5Client</string>
    </dict>
  </dict>
</dict>
</plist>
