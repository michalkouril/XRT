<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required to open XrtFlashClient: the dext's FlashUserClientProperties
       personality names this entitlement in IOUserClientEntitlements, so the
       kernel refuses IOServiceOpen(type = XRT_DEXT_CLIENT_FLASH) without it.
       Only tools that need the boot flash are signed with this. -->
  <key>org.xrtmac.flash-access</key><true/>
</dict>
</plist>
